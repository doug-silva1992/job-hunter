# Copie para .env para rodar o backend fora do Docker (npm run start:dev).

PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobhunter
DB_PASSWORD=jobhunter
DB_NAME=jobhunter

# JWT (obrigatório). Gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Pasta onde os currículos enviados são gravados (um subdiretório por usuário)
UPLOAD_DIR=storage/curriculos

# Webhook do n8n que recebe os currículos enviados (multipart/form-data, arquivo binário no campo "data")
N8N_ATS_WEBHOOK_URL=http://localhost:5678/webhook-test/ats-check
N8N_ATS_WEBHOOK_TIMEOUT_MS=60000
