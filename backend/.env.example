# Copie para .env para rodar o backend fora do Docker (npm run start:dev).

PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobhunter
DB_PASSWORD=jobhunter
DB_NAME=jobhunter

# JWT (obrigatório). Gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Pasta onde os currículos enviados são gravados (um subdiretório por usuário)
UPLOAD_DIR=storage/curriculos

# Webhook do n8n que recebe os currículos enviados (multipart/form-data, arquivo binário no campo "data")
N8N_ATS_WEBHOOK_URL=http://localhost:5678/webhook/ats-check
N8N_ATS_WEBHOOK_TIMEOUT_MS=60000

# Webhook do n8n que busca vagas para um currículo (multipart/form-data: fileName, user_id, resume_id)
N8N_SEARCH_JOBS_WEBHOOK_URL=http://localhost:5678/webhook/search-jobs
N8N_SEARCH_JOBS_WEBHOOK_TIMEOUT_MS=60000

# Pasta dos áudios das simulações de entrevista (<userId>/<relatorioId>/resposta-N.ext)
INTERVIEW_AUDIO_DIR=storage/entrevistas

# Webhook do n8n que avalia a entrevista (multipart/form-data: cargo, requisitos, nome, email, user_id;
# arquivos pergunta1..pergunta4). Responde com a linha gravada na tabela interviews.
N8N_INTERVIEW_WEBHOOK_URL=http://localhost:5678/webhook/interview_training
N8N_INTERVIEW_WEBHOOK_TIMEOUT_MS=180000

# Webhook do n8n que gera o preparatório da vaga (multipart/form-data: empresa, tags, user_id, job_id;
# tags separadas por vírgula, entre aspas as que têm espaço). A resposta do n8n volta para a tela como veio.
N8N_PREPARATION_WEBHOOK_URL=http://localhost:5678/webhook/interview-prep
N8N_PREPARATION_WEBHOOK_TIMEOUT_MS=120000
