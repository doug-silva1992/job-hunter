# Copie para .env (na raiz) antes de usar o docker-compose.prod.yml.
DB_USER=jobhunter
DB_NAME=jobhunter
# Troque por valores fortes e aleatórios:
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Webhooks do n8n
N8N_ATS_WEBHOOK_URL=
N8N_SEARCH_JOBS_WEBHOOK_URL=
# Vazio = os áudios das entrevistas ficam salvos e o envio fica pendente.
N8N_INTERVIEW_WEBHOOK_URL=
